# キー名のみ。値はコミットしない(GitHub Secrets / 実行環境の環境変数で設定)
OPENAI_API_KEY=
# 本番では GitHub Secrets に登録する(Actions が画像生成で使う)。ローカルで `npm run images` を試すときだけ設定する
# サイトの公開URL(OGP・sitemap用)。未設定ならVercelの本番URLを使う
SITE_URL=
# アフィリエイトID(秘密情報ではない。Vercelの環境変数に、ProductionとPreviewの両方で設定する。未設定のサービスは表示しない)
RAKUTEN_AFFILIATE_ID=
AMAZON_TRACKING_ID=
