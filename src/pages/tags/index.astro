---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const recipes = await getCollection('recipes');
const counts = new Map<string, number>();
for (const r of recipes) for (const t of r.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ja'));
---
<BaseLayout title="タグ一覧 | AIレシピ" description="レシピをタグから探せます。">
  <h1>タグ一覧</h1>
  <ul class="tags">
    {tags.map(([t, n]) => <li><a href={`/tags/${encodeURIComponent(t)}/`}>{t}({n})</a></li>)}
  </ul>
</BaseLayout>
