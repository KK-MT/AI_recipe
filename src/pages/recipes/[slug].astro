---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { affiliateIds, shoppingLinks } from '../../lib/affiliate.mjs';
import { NUTRIENTS, SOURCE_NAME, formatNutrient, nutritionPerServing, roundNutrition } from '../../lib/nutrition.mjs';
import foodData from '../../../data/food-composition.json';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({ params: { slug: recipe.id }, props: { recipe } }));
}

const { recipe } = Astro.props;
const { data } = recipe;
const { Content } = await render(recipe);
const shop = shoppingLinks(data.shopping, affiliateIds());
const nutrition = roundNutrition(nutritionPerServing(data, foodData.foods));

const iso = (m: number) => `PT${m}M`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: data.title,
  description: data.description,
  image: [new URL(data.image.src, Astro.site).href],
  datePublished: data.publishedAt.toISOString().slice(0, 10),
  author: { '@type': 'Organization', name: 'AIレシピ' },
  recipeYield: `${data.servings}人分`,
  prepTime: iso(data.prepMinutes),
  cookTime: iso(data.cookMinutes),
  totalTime: iso(data.prepMinutes + data.cookMinutes),
  recipeIngredient: data.ingredients.map((i) => `${i.name} ${i.amount}`),
  recipeInstructions: data.steps.map((text) => ({ '@type': 'HowToStep', text })),
  keywords: data.tags.join(', '),
  // 食塩相当量はナトリウム(sodiumContent)と異なるため入れない
  ...(nutrition?.energy != null && {
    nutrition: {
      '@type': 'NutritionInformation',
      servingSize: '1人分',
      calories: `${nutrition.energy} kcal`,
      ...(nutrition.protein != null && { proteinContent: `${nutrition.protein} g` }),
      ...(nutrition.fat != null && { fatContent: `${nutrition.fat} g` }),
      ...(nutrition.carbohydrate != null && { carbohydrateContent: `${nutrition.carbohydrate} g` }),
    },
  }),
};
---
<BaseLayout title={`${data.title} | AIレシピ`} description={data.description} image={data.image.src} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <h1>{data.title}</h1>
    <p><span class="badge">AI生成</span></p>
    <img src={data.image.src} alt={data.image.alt} />
    <p class="caption">AI生成画像</p>
    <p>{data.description}</p>
    <ul class="tags">
      {data.tags.map((t) => <li><a href={`/tags/${encodeURIComponent(t)}/`}>{t}</a></li>)}
    </ul>
    <p>調理時間: 準備 {data.prepMinutes} 分 + 調理 {data.cookMinutes} 分 / {data.servings} 人分</p>

    <h2>材料</h2>
    <ul>
      {data.ingredients.map((i) => <li>{i.name}: {i.amount}</li>)}
    </ul>

    <h2>作り方</h2>
    <ol>
      {data.steps.map((s) => <li>{s}</li>)}
    </ol>

    <h2>コツ</h2>
    <p>{data.tips}</p>

    {nutrition && (
      <section class="nutrition">
        <h2>栄養成分(1人分・目安)</h2>
        <table>
          <tbody>
            {NUTRIENTS.map((n) => (
              <tr><th scope="row">{n.label}</th><td>{formatNutrient(nutrition[n.key], n)}</td></tr>
            ))}
          </tbody>
        </table>
        <p class="caption">
          {SOURCE_NAME}(文部科学省)をもとに計算した目安です。調理による重量・成分の変化、食材ごとの差は考慮していません。煮汁・汁も含めた全量の値です。
        </p>
      </section>
    )}

    <h2>アレルゲン(特定原材料)</h2>
    <p>{data.allergens.length ? data.allergens.join('、') : '特定原材料7品目は使用していません'}</p>

    <Content />

    {shop.length > 0 && (
      <section class="shopping">
        <h2>使った道具・材料 <span class="badge">PR</span></h2>
        <p class="caption">※広告(アフィリエイト)を含みます。価格・在庫は、各ショップでご確認ください。</p>
        <ul>
          {shop.map((item) => (
            <li>
              <span class="shop-label">{item.label}</span>
              <span class="shop-links">
                {item.links.map((l) => (
                  <a href={l.url} rel="sponsored nofollow noopener" target="_blank">{l.name}</a>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
<style>
  .nutrition table { border-collapse: collapse; width: 100%; max-width: 360px; font-size: 0.9375rem; }
  .nutrition th, .nutrition td { padding: 6px 8px; border-bottom: 1px solid #e5e1d8; }
  .nutrition th { text-align: left; font-weight: normal; }
  .nutrition td { text-align: right; font-variant-numeric: tabular-nums; }
  .shopping { margin-top: 24px; padding: 12px 16px; border: 1px solid #e5e1d8; border-radius: 8px; background: #fff; }
  .shopping h2 { margin-top: 0; }
  .shopping ul { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 10px; }
  .shopping li { display: block; }
  .shop-label { display: block; font-weight: bold; margin-bottom: 4px; }
  .shop-links { display: flex; flex-wrap: wrap; gap: 8px; }
  .shop-links a { display: inline-block; padding: 4px 12px; border: 1px solid var(--accent); border-radius: 999px; font-size: 0.8125rem; text-decoration: none; }
</style>
