---
import { affiliateIds, hasProvider } from '../lib/affiliate.mjs';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}
const { title, description = 'AIが作る料理レシピ', image, type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const ids = affiliateIds();
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="AIレシピ" />
    <meta property="og:locale" content="ja_JP" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo">AIレシピ</a>
      <nav>
        <a href="/tags/">タグ</a>
        <a href="/about/">このサイトについて</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <p>このサイトのレシピと画像はAIが生成しています。</p>
      {hasProvider(ids) && (
        <p>当サイトには、アフィリエイト広告({[ids.rakuten && '楽天アフィリエイト', ids.amazon && 'Amazonアソシエイト'].filter(Boolean).join('、')})へのリンクが含まれます。</p>
      )}
      {ids.amazon && <p>Amazonのアソシエイトとして、適格販売により収入を得ています。</p>}
    </footer>
    <style is:global>
      :root { --fg: #222; --bg: #fffdf8; --accent: #c2410c; --muted: #6b7280; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: system-ui, sans-serif; color: var(--fg); background: var(--bg); line-height: 1.7; }
      a { color: var(--accent); }
      img { max-width: 100%; height: auto; display: block; }
      .site-header { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid #eee; flex-wrap: wrap; }
      .site-header a { text-decoration: none; }
      .site-header .logo { font-weight: bold; }
      .site-header nav { display: flex; gap: 16px; font-size: 0.875rem; }
      main { max-width: 720px; margin: 0 auto; padding: 16px; }
      .site-footer { padding: 16px; text-align: center; color: var(--muted); font-size: 0.875rem; }
      .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; background: var(--accent); color: #fff; font-size: 0.75rem; margin-right: 6px; }
      .caption { color: var(--muted); font-size: 0.75rem; margin: 4px 0 0; }
      .tags { list-style: none; padding: 0; margin: 8px 0; display: flex; flex-wrap: wrap; gap: 8px; }
      .tags a { display: inline-block; padding: 2px 10px; border: 1px solid #ddd; border-radius: 999px; font-size: 0.8125rem; text-decoration: none; color: var(--fg); }
    </style>
  </body>
</html>
